# ============================================================
# Gen B Tournaments — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# The app must build without any of these filled (UI runs; live
# backend features activate when provided).
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (free tier) ---
# Project URL + anon key: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings → Database → Connection string → URI)
# Used ONLY by scripts/apply-migrations.mjs
DATABASE_URL=

# --- Payments (sandbox until keys provided) ---
# Real-money features stay OFF via feature_flags until compliance approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- Email (transactional, optional) ---
RESEND_API_KEY=

# --- Web Push (optional) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
