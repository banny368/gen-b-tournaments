# =============================================================================
# Gen B Tournaments — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY — Never commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account.json

# Supabase service role key (if ever put in a file)
supabase-service-role.txt
service_role.txt

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml

# -----------------------------------------------------------------------------
# Build / Distribution
# -----------------------------------------------------------------------------
dist/
build/
out/
.output/
.nuxt/
.next/
.cache/
.parcel-cache/
.vite/
*.bundle.js
*.min.js.map

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# IDE / Editor Files
# -----------------------------------------------------------------------------

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# Vim / Neovim
*.swp
*.swo
*.swn
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
.netrwhist
tags

# Emacs
*~
\#*\#
.\#*
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
.sublime-clang-format.json

# Cursor / AI editors
.cursor/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.playwright/

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp

# -----------------------------------------------------------------------------
# Supabase CLI (if used locally)
# -----------------------------------------------------------------------------
.supabase/
supabase/.branches/
supabase/.temp/

# -----------------------------------------------------------------------------
# Vercel (local dev artifacts)
# -----------------------------------------------------------------------------
.vercel/
.vercel

# -----------------------------------------------------------------------------
# Project-Specific
# -----------------------------------------------------------------------------

# Local config overrides (never commit local settings)
assets/js/config.local.js
config.local.js

# Admin panel backups / exports
admin/backups/
exports/
*.csv.bak

# Uploaded files during local development
uploads/
local-uploads/

# Screenshot testing
screenshots/
*.screenshot.png

# Design files (large binaries — use separate asset repo if needed)
*.psd
*.ai
*.sketch
*.fig
*.xd
